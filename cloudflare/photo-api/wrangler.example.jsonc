{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aima-photo-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "routes": [
    { "pattern": "sunoisrael.com/api/*", "zone_name": "sunoisrael.com" }
  ],
  "vars": {
    "SITE_ORIGIN": "https://sunoisrael.com",
    "ADMIN_EMAIL": "tyzworks@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aima-photo-requests",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "aima-artist-images" }
  ]
}
